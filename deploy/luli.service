[Unit]
Description=Luli resume workspace
After=network.target

[Service]
Type=simple
User=luli
Group=luli
WorkingDirectory=/opt/luli/current/prototype
EnvironmentFile=/etc/luli/luli.env
ExecStart=/usr/local/bin/node server/api.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/luli
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
