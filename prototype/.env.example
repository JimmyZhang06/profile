# Development defaults: API on loopback, PGlite on disk, email codes in local mailbox.
APP_ORIGIN=http://127.0.0.1:4174
API_PORT=4175
LULI_DATA_DIR=.data/cloud
BOOTSTRAP_ADMIN_EMAIL=owner@luli.local

# Production requires all settings below and an HTTPS APP_ORIGIN.
# NODE_ENV=production
# CLOUD_ENABLED=true
# Use CLOUD_ENABLED=false for an explicit browser-only public release. This
# disables login, cloud data and external model APIs without a development fallback.
# DATABASE_URL=postgresql://luli:replace-me@127.0.0.1:5432/luli
# BETTER_AUTH_SECRET=generate-at-least-32-random-characters
# CREDENTIAL_KEY=base64-encoded-32-random-bytes
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=mailer@example.com
# SMTP_PASSWORD=replace-me
# MAIL_FROM=履历 <noreply@example.com>
# Exact domain allowlist; empty blocks all cloud model destinations.
MODEL_ALLOWED_HOSTS=
