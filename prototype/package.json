{
  "name": "luli-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:api": "node --env-file-if-exists=.env server/api.mjs",
    "start": "node --env-file-if-exists=.env server/api.mjs",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "icons": "node scripts/generate-app-icons.mjs",
    "preview": "vite preview",
    "test": "node --test tests/revision-scroll.test.mjs tests/delivery.test.mjs tests/workspace.test.mjs tests/navigation.test.mjs tests/documents.test.mjs tests/resume-import.test.mjs tests/projects.test.mjs tests/interaction.test.mjs tests/formatting.test.mjs tests/profile.test.mjs tests/experience-preview.test.mjs tests/avatar.test.mjs tests/cloud.test.mjs tests/cloud-sync.test.mjs tests/deployment.test.mjs tests/admin-setup.test.mjs tests/webapp.test.mjs tests/model-domains.test.mjs tests/opportunities.test.mjs tests/offers-engine.test.mjs tests/offers-route.test.mjs tests/career-handoff.test.mjs tests/career-benchmarks.test.mjs",
    "test:models": "node --test tests/model-domains.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:resume-import": "node tests/browser/resume-import.mjs",
    "test:offer-cards": "node tests/browser/offer-cards.mjs",
    "dev:client": "vite",
    "test:cloud": "node --test tests/cloud.test.mjs tests/cloud-sync.test.mjs tests/admin-setup.test.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@tabler/icons-react": "^3.50.0",
    "@tiptap/pm": "3.32.1",
    "@tiptap/react": "3.32.1",
    "@tiptap/starter-kit": "3.32.1",
    "@vitejs/plugin-react": "5.0.4",
    "better-auth": "1.7.14",
    "ipaddr.js": "2.5.0",
    "kysely": "0.28.17",
    "kysely-pglite": "0.6.1",
    "nodemailer": "10.3.1",
    "otplib": "13.5.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "undici": "8.12.3",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "cfb": "1.2.2",
    "fflate": "0.8.3",
    "pdfjs-dist": "5.7.284",
    "prettier": "3.9.10",
    "tesseract.js": "6.0.1"
  }
}
